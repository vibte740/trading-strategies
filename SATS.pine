//@version=6
// ══════════════════════════════════════════════════════════
// SATS 15M Precision — Confluence Signal & Adaptive TP Engine
// Compatible with tv-webhook-receiver (/webhooks/all, <300 chars):
// {secret, exchange, symbol, side, leverage, entry, sl, tp1, tp2[, qty]}
// ══════════════════════════════════════════════════════════
indicator(
     title            = "SATS 15M Precision Webhook",
     shorttitle       = "SATS-15M",
     overlay          = true,
     max_lines_count  = 500,
     max_labels_count = 500,
     max_boxes_count  = 100,
     max_bars_back    = 5000)

// ── Groups ────────────────────────────────────────────────
GRP_SIG  = "🎯 15M Signal Engine"
GRP_FLT  = "🛡️ Anti-Chase & Structure Filters"
GRP_TP   = "💰 Intelligent Adaptive TP Engine"
GRP_SL   = "🛑 Stop-Loss & Risk"
GRP_VIS  = "🎨 Visuals & Dashboard"
GRP_WEB  = "🔔 Webhook"

// ── Inputs: 15M Signal Engine ─────────────────────────────
emaFastLen     = input.int(9,  "EMA Fast", minval = 2, maxval = 50, group = GRP_SIG)
emaMidLen      = input.int(21, "EMA Mid",  minval = 5, maxval = 100, group = GRP_SIG)
emaSlowLen     = input.int(50, "EMA Slow", minval = 20, maxval = 200, group = GRP_SIG)
rsiLen         = input.int(14, "RSI Length", minval = 5, maxval = 50, group = GRP_SIG)
adxLen         = input.int(14, "ADX Length", minval = 5, maxval = 50, group = GRP_SIG)
adxMin         = input.float(18.0, "Min ADX (Trend Strength)", minval = 5.0, maxval = 50.0, step = 1.0, group = GRP_SIG)
rvolLen        = input.int(20, "RVOL Lookback", minval = 5, maxval = 100, group = GRP_SIG)
rvolMin        = input.float(1.10, "Min RVOL Confirmation", minval = 0.5, maxval = 3.0, step = 0.05, group = GRP_SIG)
minScoreInput  = input.int(6, "Min Confluence Score (out of 9)", minval = 4, maxval = 9, group = GRP_SIG)

// ── Inputs: Anti-Chase & Structure Filters ────────────────
atrLen         = input.int(14, "ATR Length", minval = 5, maxval = 50, group = GRP_FLT)
maxCandleAtr   = input.float(1.8, "Max Signal Candle Range (xATR)", minval = 0.8, maxval = 4.0, step = 0.1, group = GRP_FLT)
maxDistEmaAtr  = input.float(1.6, "Max Distance from EMA21 (xATR)", minval = 0.5, maxval = 4.0, step = 0.1, group = GRP_FLT)
minBodyRatio   = input.float(0.42, "Min Candle Body Ratio", minval = 0.1, maxval = 0.9, step = 0.05, group = GRP_FLT)
pivotLen       = input.int(5, "Swing / S&R Pivot Strength", minval = 2, maxval = 15, group = GRP_FLT)
minRoomAtr     = input.float(0.75, "Min Room to Nearest S/R (xATR)", minval = 0.2, maxval = 2.5, step = 0.05, group = GRP_FLT)
useTradeLock   = input.bool(true, "Lock Signals Until Active Trade Ends", group = GRP_FLT)
cooldownBars   = input.int(4, "Min Cooldown Bars Between Signals", minval = 1, maxval = 30, group = GRP_FLT)

// ── Inputs: Intelligent Adaptive TP Engine ────────────────
tp1AtrBase     = input.float(0.90, "TP1 Base Distance (xATR)", minval = 0.4, maxval = 2.0, step = 0.05, group = GRP_TP)
tp2AtrBase     = input.float(1.60, "TP2 Base Distance (xATR)", minval = 0.8, maxval = 3.5, step = 0.1, group = GRP_TP)
tp3AtrBase     = input.float(2.40, "TP3 Base Distance (xATR, chart)", minval = 1.2, maxval = 5.0, step = 0.1, group = GRP_TP)
srSnapBuffer   = input.float(0.12, "S/R Front-Run Buffer (xATR)", minval = 0.0, maxval = 0.5, step = 0.02, group = GRP_TP)
useSrCap       = input.bool(true, "Cap TP1/TP2 Before Nearby S/R", group = GRP_TP)
tradeTimeout   = input.int(48, "Trade Timeout (bars, 48=12h on 15m)", minval = 8, maxval = 200, group = GRP_TP)

// ── Inputs: Stop-Loss & Risk ──────────────────────────────
slAtrMult      = input.float(1.25, "SL Base Multiplier (xATR)", minval = 0.5, maxval = 3.0, step = 0.05, group = GRP_SL)
slMaxAtr       = input.float(1.75, "SL Hard Cap (xATR)", minval = 0.8, maxval = 4.0, step = 0.05, group = GRP_SL)
slPivotBuf     = input.float(0.25, "SL Pivot Buffer (xATR)", minval = 0.0, maxval = 1.0, step = 0.05, group = GRP_SL)

// ── Inputs: Visuals & Dashboard ───────────────────────────
showEmas       = input.bool(true, "Show EMA 9 / 21 / 50", group = GRP_VIS)
showLevels     = input.bool(true, "Show Entry / SL / TP Lines", group = GRP_VIS)
showSrLines    = input.bool(true, "Show Local S/R Zones", group = GRP_VIS)
showDash       = input.bool(true, "Show Performance Dashboard", group = GRP_VIS)
labelOffset    = input.int(10, "Label Offset (bars)", minval = 5, maxval = 50, group = GRP_VIS)

// ── Inputs: Webhook ───────────────────────────────────────
enableAlerts   = input.bool(true, "Enable Webhook Alerts", group = GRP_WEB)
secretKey      = input.string("PASTE_YOUR_WEBHOOK_SECRET", "Webhook Secret", group = GRP_WEB)
exchangeInput  = input.string("binance_futures", "Exchange", group = GRP_WEB)
leverage       = input.int(5, "Leverage", minval = 1, maxval = 125, group = GRP_WEB)
includeQty     = input.bool(false, "Include Qty (off = server 20% sizing)", group = GRP_WEB)
equity         = input.float(10000.0, "Account Equity (if Qty on)", minval = 1.0, group = GRP_WEB)
riskPct        = input.float(1.0, "Risk % (if Qty on)", minval = 0.1, step = 0.1, group = GRP_WEB)

// ══════════════════════════════════════════════════════════
// 1. CORE INDICATORS (15M ENGINE)
// ══════════════════════════════════════════════════════════
float ema9   = ta.ema(close, emaFastLen)
float ema21  = ta.ema(close, emaMidLen)
float ema50  = ta.ema(close, emaSlowLen)
float atr    = nz(ta.atr(atrLen), 0.0)
float atrSma = nz(ta.sma(atr, 50), atr)
float volReg = atrSma > 0 ? atr / atrSma : 1.0

float rsi      = nz(ta.rsi(close, rsiLen), 50.0)
bool  rsiAccelUp   = rsi > rsi[1] and rsi > 48 and rsi < 68
bool  rsiAccelDown = rsi < rsi[1] and rsi < 52 and rsi > 32

[diPlus, diMinus, adx] = ta.dmi(adxLen, adxLen)
bool adxStrongLong  = adx >= adxMin and diPlus > diMinus
bool adxStrongShort = adx >= adxMin and diMinus > diPlus

[macdLine, sigLine, macdHist] = ta.macd(close, 12, 26, 9)
bool macdBull = macdHist > 0 and macdHist > macdHist[1]
bool macdBear = macdHist < 0 and macdHist < macdHist[1]

float volSma = nz(ta.sma(volume, rvolLen), 1.0)
float rvol   = volSma > 0 ? volume / volSma : 1.0
bool  volOk  = rvol >= rvolMin

// Candle anatomy (body strength & wick rejection)
float cRange     = high - low
float cBody      = math.abs(close - open)
float bodyRatio  = cRange > 0 ? cBody / cRange : 0.0
float upperWick  = high - math.max(open, close)
float lowerWick  = math.min(open, close) - low
bool  bullCandle = close > open and bodyRatio >= minBodyRatio and upperWick <= cBody * 0.65
bool  bearCandle = close < open and bodyRatio >= minBodyRatio and lowerWick <= cBody * 0.65

// ══════════════════════════════════════════════════════════
// 2. MARKET STRUCTURE (HH/HL/LH/LL, BOS/CHoCH, FVG, S&R)
// ══════════════════════════════════════════════════════════
float ph = ta.pivothigh(high, pivotLen, pivotLen)
float pl = ta.pivotlow(low, pivotLen, pivotLen)

var float lastSwHigh = na
var float prevSwHigh = na
var float lastSwLow  = na
var float prevSwLow  = na
var int   structBias = 0

if not na(ph)
    prevSwHigh := lastSwHigh
    lastSwHigh := ph
if not na(pl)
    prevSwLow := lastSwLow
    lastSwLow := pl

bool isHH = not na(lastSwHigh) and not na(prevSwHigh) and lastSwHigh > prevSwHigh
bool isHL = not na(lastSwLow)  and not na(prevSwLow)  and lastSwLow > prevSwLow
bool isLH = not na(lastSwHigh) and not na(prevSwHigh) and lastSwHigh < prevSwHigh
bool isLL = not na(lastSwLow)  and not na(prevSwLow)  and lastSwLow < prevSwLow

bool bosUp   = not na(lastSwHigh) and close > lastSwHigh and close[1] <= lastSwHigh
bool bosDown = not na(lastSwLow)  and close < lastSwLow  and close[1] >= lastSwLow

if bosUp
    structBias := 1
else if bosDown
    structBias := -1

bool structBull = structBias == 1 or (isHH and isHL) or bosUp
bool structBear = structBias == -1 or (isLH and isLL) or bosDown

// Fair Value Gap (FVG) detection (recent 3-bar imbalance)
bool fvgBullNow = low > high[2] and close[1] > open[1]
bool fvgBearNow = high < low[2] and close[1] < open[1]
var int lastBullFvgBar = -999
var int lastBearFvgBar = -999
if fvgBullNow
    lastBullFvgBar := bar_index
if fvgBearNow
    lastBearFvgBar := bar_index
bool recentBullFvg = (bar_index - lastBullFvgBar) <= 6
bool recentBearFvg = (bar_index - lastBearFvgBar) <= 6

// Local Liquidity / Resistance & Support zones (24-bar & 60-bar)
float nearRes = ta.highest(high[1], 24)
float farRes  = ta.highest(high[1], 60)
float nearSup = ta.lowest(low[1], 24)
float farSup  = ta.lowest(low[1], 60)

float roomUpAtr   = atr > 0 ? (nearRes - close) / atr : 99.0
float roomDownAtr = atr > 0 ? (close - nearSup) / atr : 99.0

// ══════════════════════════════════════════════════════════
// 3. CONFLUENCE SCORING & ANTI-CHASE GATES
// ══════════════════════════════════════════════════════════
bool emaAlignLong  = ema9 > ema21 and ema21 > ema50 and close > ema9
bool emaAlignShort = ema9 < ema21 and ema21 < ema50 and close < ema9

bool notExtendedCandle = atr > 0 and cRange <= maxCandleAtr * atr
bool notOverextendedL  = atr > 0 and (close - ema21) <= maxDistEmaAtr * atr and close >= ema21
bool notOverextendedS  = atr > 0 and (ema21 - close) <= maxDistEmaAtr * atr and close <= ema21
bool hasRoomLong       = roomUpAtr >= minRoomAtr or close > nearRes
bool hasRoomShort      = roomDownAtr >= minRoomAtr or close < nearSup

int longScore = 0
longScore += emaAlignLong ? 2 : (ema9 > ema21 and close > ema21 ? 1 : 0)
longScore += rsiAccelUp ? 1 : 0
longScore += adxStrongLong ? 1 : 0
longScore += macdBull ? 1 : 0
longScore += volOk ? 1 : 0
longScore += bullCandle ? 1 : 0
longScore += structBull ? 1 : 0
longScore += recentBullFvg ? 1 : 0

int shortScore = 0
shortScore += emaAlignShort ? 2 : (ema9 < ema21 and close < ema21 ? 1 : 0)
shortScore += rsiAccelDown ? 1 : 0
shortScore += adxStrongShort ? 1 : 0
shortScore += macdBear ? 1 : 0
shortScore += volOk ? 1 : 0
shortScore += bearCandle ? 1 : 0
shortScore += structBear ? 1 : 0
shortScore += recentBearFvg ? 1 : 0

// Track active trade & prevent repeated signals in same leg
var int   activeDir      = 0
var int   entryBar       = -999
var int   lastSigBar     = -999
var int   lastLegDir     = 0
var float tradeEntry     = na
var float tradeSl        = na
var float tradeTp1       = na
var float tradeTp2       = na
var float tradeTp3       = na
var bool  hitTp1         = false
var bool  hitTp2         = false
var bool  hitTp3         = false

// Reset leg lock once price pulls back to EMA21
if lastLegDir == 1 and low <= ema21
    lastLegDir := 0
if lastLegDir == -1 and high >= ema21
    lastLegDir := 0

bool isWarmedUp  = bar_index >= 65 and atr > 0
bool canTrade    = (not useTradeLock or activeDir == 0) and (bar_index - lastSigBar >= cooldownBars)

bool rawLongSig  = isWarmedUp and barstate.isconfirmed and canTrade and lastLegDir != 1 and longScore >= minScoreInput and notExtendedCandle and notOverextendedL and hasRoomLong
bool rawShortSig = isWarmedUp and barstate.isconfirmed and canTrade and lastLegDir != -1 and shortScore >= minScoreInput and notExtendedCandle and notOverextendedS and hasRoomShort

// ══════════════════════════════════════════════════════════
// 4. INTELLIGENT ADAPTIVE TP & SL ENGINE
// ══════════════════════════════════════════════════════════
// Momentum & volatility multiplier (scales targets realistically for 15m)
float momFactor = math.max(0.80, math.min(1.25, 0.85 + (adx - 15.0) * 0.01 + (rvol - 1.0) * 0.12))
float volClamp  = math.max(0.85, math.min(1.20, volReg))
float tpScale   = (momFactor + volClamp) * 0.5

if rawLongSig
    float tEntry = close
    float swingSl = not na(lastSwLow) ? lastSwLow - slPivotBuf * atr : tEntry - slAtrMult * atr
    float atrSl   = tEntry - slAtrMult * atr
    float capSl   = tEntry - slMaxAtr * atr
    float tSl     = math.max(capSl, math.min(atrSl, swingSl))
    if tSl >= tEntry - 0.4 * atr
        tSl := tEntry - slAtrMult * atr

    float rawTp1 = tEntry + atr * tp1AtrBase * tpScale
    float rawTp2 = tEntry + atr * tp2AtrBase * tpScale
    float rawTp3 = tEntry + atr * tp3AtrBase * tpScale

    // Snap/Cap TP1 & TP2 before nearby resistance so targets actually fill
    float srCap1 = nearRes - srSnapBuffer * atr
    float srCap2 = farRes  - srSnapBuffer * atr
    float tTp1   = useSrCap and srCap1 > tEntry + 0.55 * atr and srCap1 < rawTp1 ? srCap1 : rawTp1
    float tTp2   = useSrCap and srCap2 > tTp1 + 0.35 * atr and srCap2 < rawTp2 ? srCap2 : math.max(rawTp2, tTp1 + 0.5 * atr)
    float tTp3   = math.max(rawTp3, tTp2 + 0.6 * atr)

    activeDir  := 1
    entryBar   := bar_index
    lastSigBar := bar_index
    lastLegDir := 1
    tradeEntry := tEntry
    tradeSl    := tSl
    tradeTp1   := tTp1
    tradeTp2   := tTp2
    tradeTp3   := tTp3
    hitTp1     := false
    hitTp2     := false
    hitTp3     := false

if rawShortSig
    float tEntry = close
    float swingSl = not na(lastSwHigh) ? lastSwHigh + slPivotBuf * atr : tEntry + slAtrMult * atr
    float atrSl   = tEntry + slAtrMult * atr
    float capSl   = tEntry + slMaxAtr * atr
    float tSl     = math.min(capSl, math.max(atrSl, swingSl))
    if tSl <= tEntry + 0.4 * atr
        tSl := tEntry + slAtrMult * atr

    float rawTp1 = tEntry - atr * tp1AtrBase * tpScale
    float rawTp2 = tEntry - atr * tp2AtrBase * tpScale
    float rawTp3 = tEntry - atr * tp3AtrBase * tpScale

    // Snap/Cap TP1 & TP2 before nearby support so targets actually fill
    float srCap1 = nearSup + srSnapBuffer * atr
    float srCap2 = farSup  + srSnapBuffer * atr
    float tTp1   = useSrCap and srCap1 < tEntry - 0.55 * atr and srCap1 > rawTp1 ? srCap1 : rawTp1
    float tTp2   = useSrCap and srCap2 < tTp1 - 0.35 * atr and srCap2 > rawTp2 ? srCap2 : math.min(rawTp2, tTp1 - 0.5 * atr)
    float tTp3   = math.min(rawTp3, tTp2 - 0.6 * atr)

    activeDir  := -1
    entryBar   := bar_index
    lastSigBar := bar_index
    lastLegDir := -1
    tradeEntry := tEntry
    tradeSl    := tSl
    tradeTp1   := tTp1
    tradeTp2   := tTp2
    tradeTp3   := tTp3
    hitTp1     := false
    hitTp2     := false
    hitTp3     := false

// ══════════════════════════════════════════════════════════
// 5. HIT TRACKING & PERFORMANCE METRICS
// ══════════════════════════════════════════════════════════
var int totalTrades = 0
var int tp1Wins     = 0
var int tp2Wins     = 0
var int slLosses    = 0

var line  lnEntry = na
var line  lnSl    = na
var line  lnTp1   = na
var line  lnTp2   = na
var line  lnTp3   = na
var label lbEntry = na
var label lbSl    = na
var label lbTp1   = na
var label lbTp2   = na
var label lbTp3   = na

if activeDir != 0 and barstate.isconfirmed and bar_index > entryBar
    bool isTp1 = activeDir == 1 ? high >= tradeTp1 : low <= tradeTp1
    bool isTp2 = activeDir == 1 ? high >= tradeTp2 : low <= tradeTp2
    bool isTp3 = activeDir == 1 ? high >= tradeTp3 : low <= tradeTp3
    bool isSl  = activeDir == 1 ? low <= tradeSl   : high >= tradeSl
    bool isTo  = (bar_index - entryBar) >= tradeTimeout

    if isTp1 and not hitTp1
        hitTp1 := true
        if showLevels and not na(lnTp1)
            line.set_style(lnTp1, line.style_solid)
            label.set_text(lbTp1, "TP1 ✓ " + str.tostring(tradeTp1, format.mintick))
    if isTp2 and not hitTp2
        hitTp2 := true
        if showLevels and not na(lnTp2)
            line.set_style(lnTp2, line.style_solid)
            label.set_text(lbTp2, "TP2 ✓ " + str.tostring(tradeTp2, format.mintick))
    if isTp3 and not hitTp3
        hitTp3 := true
        if showLevels and not na(lnTp3)
            line.set_style(lnTp3, line.style_solid)
            label.set_text(lbTp3, "TP3 ✓ " + str.tostring(tradeTp3, format.mintick))

    if hitTp2 or isSl or isTo
        totalTrades += 1
        if hitTp1
            tp1Wins += 1
        if hitTp2
            tp2Wins += 1
        if isSl and not hitTp1
            slLosses += 1
        activeDir := 0

// ══════════════════════════════════════════════════════════
// 6. WEBHOOK ALERT (Compact JSON <300 chars)
// ══════════════════════════════════════════════════════════
if enableAlerts and (rawLongSig or rawShortSig) and not na(tradeEntry) and not na(tradeSl)
    float riskDist = math.abs(tradeEntry - tradeSl)
    float qty      = riskDist > 0 ? equity * riskPct / 100.0 / riskDist : na
    bool  okLevels = riskDist > 0 and (rawLongSig ? tradeSl < tradeEntry : tradeSl > tradeEntry) and (not includeQty or not na(qty))
    if okLevels
        string sideStr     = rawLongSig ? "LONG" : "SHORT"
        string cleanTicker = str.replace_all(syminfo.ticker, ".P", "")
        string qtyPart     = includeQty ? ',"qty":' + str.tostring(qty, "#.####") : ""
        string payload     = '{"secret":"' + secretKey + '","exchange":"' + exchangeInput + '","symbol":"' + cleanTicker + '","side":"' + sideStr + '","leverage":' + str.tostring(leverage) + ',"entry":' + str.tostring(tradeEntry, format.mintick) + ',"sl":' + str.tostring(tradeSl, format.mintick) + ',"tp1":' + str.tostring(tradeTp1, format.mintick) + ',"tp2":' + str.tostring(tradeTp2, format.mintick) + qtyPart + '}'
        alert(payload, alert.freq_once_per_bar_close)

plot(tradeEntry, "entry", display = display.none)
plot(tradeSl,    "sl",    display = display.none)
plot(tradeTp1,   "tp1",   display = display.none)
plot(tradeTp2,   "tp2",   display = display.none)

alertcondition(rawLongSig,  title = "SATS 15M LONG",  message = "SATS 15M LONG - {{ticker}}")
alertcondition(rawShortSig, title = "SATS 15M SHORT", message = "SATS 15M SHORT - {{ticker}}")

// ══════════════════════════════════════════════════════════
// 7. VISUALS & DASHBOARD
// ══════════════════════════════════════════════════════════
plot(showEmas ? ema9  : na, "EMA 9",  color = color.new(#00E676, 20), linewidth = 1)
plot(showEmas ? ema21 : na, "EMA 21", color = color.new(#2962FF, 10), linewidth = 2)
plot(showEmas ? ema50 : na, "EMA 50", color = color.new(#FF9800, 15), linewidth = 2)
plot(showSrLines ? nearRes : na, "Near Resistance", color = color.new(#FF5252, 75), style = plot.style_stepline)
plot(showSrLines ? nearSup : na, "Near Support",    color = color.new(#00E676, 75), style = plot.style_stepline)

if rawLongSig
    label.new(bar_index, low, "▲ LONG (" + str.tostring(longScore) + "/9)", color = #00E676, textcolor = #000000, style = label.style_label_up, size = size.small)
if rawShortSig
    label.new(bar_index, high, "▼ SHORT (" + str.tostring(shortScore) + "/9)", color = #FF5252, textcolor = #FFFFFF, style = label.style_label_down, size = size.small)

if showLevels
    if rawLongSig or rawShortSig
        line.delete(lnEntry), line.delete(lnSl), line.delete(lnTp1), line.delete(lnTp2), line.delete(lnTp3)
        label.delete(lbEntry), label.delete(lbSl), label.delete(lbTp1), label.delete(lbTp2), label.delete(lbTp3)
        int x2 = bar_index + labelOffset
        int xl = x2 + 2
        lnEntry := line.new(bar_index, tradeEntry, x2, tradeEntry, color = color.gray, width = 2)
        lnSl    := line.new(bar_index, tradeSl,    x2, tradeSl,    color = #FF1744, width = 2)
        lnTp1   := line.new(bar_index, tradeTp1,   x2, tradeTp1,   color = #00E676, width = 1, style = line.style_dashed)
        lnTp2   := line.new(bar_index, tradeTp2,   x2, tradeTp2,   color = #00E676, width = 1, style = line.style_dashed)
        lnTp3   := line.new(bar_index, tradeTp3,   x2, tradeTp3,   color = #40E0D0, width = 1, style = line.style_dotted)
        lbEntry := label.new(xl, tradeEntry, "ENTRY " + str.tostring(tradeEntry, format.mintick), color = color.new(color.gray, 60), textcolor = color.white, style = label.style_label_left, size = size.small)
        lbSl    := label.new(xl, tradeSl,    "SL "    + str.tostring(tradeSl,    format.mintick), color = color.new(#FF1744, 50),    textcolor = color.white, style = label.style_label_left, size = size.small)
        lbTp1   := label.new(xl, tradeTp1,   "TP1 "   + str.tostring(tradeTp1,   format.mintick), color = color.new(#00E676, 55),    textcolor = color.white, style = label.style_label_left, size = size.small)
        lbTp2   := label.new(xl, tradeTp2,   "TP2 "   + str.tostring(tradeTp2,   format.mintick), color = color.new(#00E676, 55),    textcolor = color.white, style = label.style_label_left, size = size.small)
        lbTp3   := label.new(xl, tradeTp3,   "TP3 "   + str.tostring(tradeTp3,   format.mintick), color = color.new(#40E0D0, 60),    textcolor = color.white, style = label.style_label_left, size = size.small)
    else if activeDir != 0 and not na(lnEntry)
        int x2 = bar_index + labelOffset
        int xl = x2 + 2
        line.set_x2(lnEntry, x2), line.set_x2(lnSl, x2), line.set_x2(lnTp1, x2), line.set_x2(lnTp2, x2), line.set_x2(lnTp3, x2)
        label.set_x(lbEntry, xl), label.set_x(lbSl, xl), label.set_x(lbTp1, xl), label.set_x(lbTp2, xl), label.set_x(lbTp3, xl)

if showDash and barstate.islast
    var table d = table.new(position.top_right, 2, 10, bgcolor = color.new(#131722, 10), border_color = #2A2E39, border_width = 1)
    float tp1Rate = totalTrades > 0 ? (tp1Wins * 100.0 / totalTrades) : 0.0
    float tp2Rate = totalTrades > 0 ? (tp2Wins * 100.0 / totalTrades) : 0.0
    table.cell(d, 0, 0, "SATS 15M Precision", text_color = color.white, bgcolor = #2962FF, text_size = size.small)
    table.cell(d, 1, 0, timeframe.period + "m", text_color = color.white, bgcolor = #2962FF, text_size = size.small)
    table.cell(d, 0, 1, "EMA Trend", text_color = color.gray, text_size = size.small)
    table.cell(d, 1, 1, emaAlignLong ? "Bullish ▲" : (emaAlignShort ? "Bearish ▼" : "Neutral"), text_color = emaAlignLong ? #00E676 : (emaAlignShort ? #FF5252 : #FFEB3B), text_size = size.small)
    table.cell(d, 0, 2, "ADX / RVOL", text_color = color.gray, text_size = size.small)
    table.cell(d, 1, 2, str.tostring(adx, "#.0") + " / " + str.tostring(rvol, "#.00") + "x", text_color = color.white, text_size = size.small)
    table.cell(d, 0, 3, "Score L / S", text_color = color.gray, text_size = size.small)
    table.cell(d, 1, 3, str.tostring(longScore) + " / " + str.tostring(shortScore) + " (min " + str.tostring(minScoreInput) + ")", text_color = color.white, text_size = size.small)
    table.cell(d, 0, 4, "TP Scale", text_color = color.gray, text_size = size.small)
    table.cell(d, 1, 4, str.tostring(tpScale, "#.00") + "x ATR", text_color = #40E0D0, text_size = size.small)
    table.cell(d, 0, 5, "Trades", text_color = color.gray, text_size = size.small)
    table.cell(d, 1, 5, str.tostring(totalTrades), text_color = color.white, text_size = size.small)
    table.cell(d, 0, 6, "TP1 Hit Rate", text_color = color.gray, text_size = size.small)
    table.cell(d, 1, 6, totalTrades > 0 ? str.tostring(tp1Rate, "#.1") + "%" : "—", text_color = tp1Rate >= 55 ? #00E676 : #FFEB3B, text_size = size.small)
    table.cell(d, 0, 7, "TP2 Hit Rate", text_color = color.gray, text_size = size.small)
    table.cell(d, 1, 7, totalTrades > 0 ? str.tostring(tp2Rate, "#.1") + "%" : "—", text_color = tp2Rate >= 35 ? #00E676 : #FFEB3B, text_size = size.small)
    table.cell(d, 0, 8, "SL Only Loss", text_color = color.gray, text_size = size.small)
    table.cell(d, 1, 8, str.tostring(slLosses), text_color = #FF5252, text_size = size.small)
