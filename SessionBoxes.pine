//@version=6
indicator("Session Boxes (UTC)", overlay=true, max_boxes_count=500, max_labels_count=500)

// ── Sessions ────────────────────────────────────────────────────────────
var g1 = "AUS (Australia)"
showAUS = input.bool(true, "Show", group=g1)
sessAUS = input.session("2300-0600", "Session (UTC)", group=g1)
colAUS  = input.color(color.new(color.silver, 0), "Color", group=g1)
styAUS  = input.string("Dotted", "Border style", options=["Solid", "Dashed", "Dotted"], group=g1)

var g2 = "JPN (Japan)"
showJPN = input.bool(true, "Show", group=g2)
sessJPN = input.session("0000-0630", "Session (UTC)", group=g2)
colJPN  = input.color(color.new(color.red, 0), "Color", group=g2)
styJPN  = input.string("Dashed", "Border style", options=["Solid", "Dashed", "Dotted"], group=g2)

var g3 = "CHN (China)"
showCHN = input.bool(true, "Show", group=g3)
sessCHN = input.session("0130-0700", "Session (UTC)", group=g3)
colCHN  = input.color(color.new(color.maroon, 0), "Color", group=g3)
styCHN  = input.string("Solid", "Border style", options=["Solid", "Dashed", "Dotted"], group=g3)

var g4 = "UK"
showUK = input.bool(true, "Show", group=g4)
sessUK = input.session("0700-1600", "Session (UTC)", group=g4)
colUK  = input.color(color.new(color.blue, 0), "Color", group=g4)
styUK  = input.string("Dashed", "Border style", options=["Solid", "Dashed", "Dotted"], group=g4)

var g5 = "USA"
showUSA = input.bool(true, "Show", group=g5)
sessUSA = input.session("1200-2100", "Session (UTC)", group=g5)
colUSA  = input.color(color.new(color.orange, 0), "Color", group=g5)
styUSA  = input.string("Solid", "Border style", options=["Solid", "Dashed", "Dotted"], group=g5)

// ── Style ───────────────────────────────────────────────────────────────
var gs = "Style"
fillTransp = input.int(92, "Fill transparency", minval=0, maxval=100, group=gs)
borderW    = input.int(1, "Border width", minval=1, maxval=4, group=gs)
txtSize    = input.string("small", "Label size", options=["tiny", "small", "normal", "large"], group=gs)

// ── Session box: live high/low range with label on top ──────────────────
toStyle(string s) =>
    s == "Dashed" ? line.style_dashed : s == "Dotted" ? line.style_dotted : line.style_solid

drawSession(string sess, string name, color col, bool enabled, string sty) =>
    var box   bx = na
    var label lb = na
    var float hi = na
    var float lo = na

    inSess  = enabled and not na(time(timeframe.period, sess, "UTC"))
    newSess = inSess and not inSess[1]

    if newSess
        hi := high
        lo := low
        bx := box.new(bar_index, hi, bar_index, lo, border_color=col, border_width=borderW,
                      border_style=toStyle(sty), bgcolor=color.new(col, fillTransp))
        lb := label.new(bar_index, hi, name, style=label.style_label_lower_left,
                        color=na, textcolor=col, size=txtSize)
    else if inSess
        hi := math.max(hi, high)
        lo := math.min(lo, low)
        box.set_right(bx, bar_index)
        box.set_top(bx, hi)
        box.set_bottom(bx, lo)
        label.set_y(lb, hi)

    inSess

if timeframe.isdwm
    runtime.error("Use an intraday timeframe (e.g. 1m–1h) for session boxes.")

drawSession(sessAUS, "AUS", colAUS, showAUS, styAUS)  // 2300
drawSession(sessJPN, "JPN", colJPN, showJPN, styJPN)  // 0000
drawSession(sessCHN, "CHN", colCHN, showCHN, styCHN)  // 0130
drawSession(sessUK,  "UK",  colUK,  showUK,  styUK)   // 0700
drawSession(sessUSA, "USA", colUSA, showUSA, styUSA)  // 1200
